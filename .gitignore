# Data — too large for git
data/bronze/**
!data/bronze/.gitkeep
data/silver/**
!data/silver/.gitkeep
data/gold/**
!data/gold/.gitkeep

# Parquet safety net (data dirs handle specific exclusions)
*.parquet
!tests/fixtures/*.parquet

# Reports (commit .md and .json, not raw outputs)
reports/**/*.html

# Python
__pycache__/
*.pyc
.mypy_cache/
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/

# IDE / OS
.DS_Store
.vscode/
.idea/
.ipynb_checkpoints/

# Env
.env
.venv/

# Local planning
.kiro/
LOCAL_PROJECT_STORY.md

# Claude local config
.claude/settings.local.json

# ML artifacts (if anomaly detection added)
models/
*.pkl
*.joblib
mlruns/
mlflow.db

# Conda
environment.yml

# Power BI (commit .pbix if small, or PDF exports only)
# powerbi/*.pbix  # uncomment if .pbix too large for git
